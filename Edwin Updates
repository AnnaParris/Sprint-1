<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Radio Map Wireframe</title>
    <link rel="stylesheet" href="style.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>

<body>

    <header>
        <h1>US Radio Map Plan Team Nashua</h1>
    </header>

    <div class="nav-links">
        <a href="#">Wireframe</a> |
        <a href="#">Working Agreement</a> |
        <a href="#">Google Doc</a> |
        <a href="#">BaseCamp</a> |
        <a href="#">Discord</a>
    </div>

    <div class="container">

        <div class="topbar">
            <div class="brand">P48</div>
            <div>
            <img id="logo" src="P48_Logo.png" alt="logo"></div>
            <div class="title">USA Radio Map</div>
            <input class="search" type="text" placeholder="Search">
        </div>

        <div class="main">
            <div id="map"></div>
        </div>

        <div class="sidebar">
            <div class="scroll-box"></div>

            <select class="state">
                <option>State</option>
            </select>

            <div class="list">
                <div> Radio 1</div>
                <div> Radio 2</div>
                <div> Radio 3</div>
            </div>
        </div>

        <div class="description">Description of the radio map</div>

        <div class="subbox">
            P48: Radio MAP
        </div>

        <div class="ads">
            <div>Ads</div>
            <div>Ads</div>
        </div>

    </div>

    <footer>
         Team Nashua | Angela Brown | Enzo Collin | Edwin Colmenares | Elizabeth Parrott
    </footer>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
